# Copie ce fichier en .env et remplis les valeurs au fur et à mesure des étapes.

# --- Étape 0 : général ---
APP_NAME="Site Plaud"
# Dossier de stockage des fichiers uploadés (local en dev, éphémère sur HF Spaces)
UPLOAD_DIR="uploads"
# Taille max d'un upload en Mo
MAX_UPLOAD_MB=200

# --- Base de données ---
# En local : fichier SQLite.
DATABASE_URL="sqlite:///data/plaud.db"
# En ligne (HF Spaces) : disque éphémère -> Turso.
#   DATABASE_URL="libsql://mon-db-mon-org.turso.io"
#   TURSO_AUTH_TOKEN="..."   (turso db tokens create mon-db)
# TURSO_AUTH_TOKEN=""

# --- Étape 2 & 3 : Groq (transcription + résumé) ---
# GROQ_API_KEY=""

# --- Étape 4 : archivage ---
# Backend : auto | b2 | drive | none  (auto = B2 si configuré, sinon Drive)
# ARCHIVE_BACKEND="auto"
# URL publique du site (pour les liens de téléchargement dans l'email)
# PUBLIC_BASE_URL="https://xxxxx.hf.space"
#
# Backblaze B2 (compatible S3) — recommandé, pas d'OAuth :
# B2_KEY_ID=""
# B2_APP_KEY=""
# B2_BUCKET="site-plaud"
# B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"   # l'endpoint affiché pour ton bucket
#
# Google Drive (facultatif) : dépose google_client_secret.json à la racine, puis
#   .venv/bin/python -m app.google_auth   (crée token.json)
# GOOGLE_CLIENT_SECRET_FILE="google_client_secret.json"
# GOOGLE_TOKEN_FILE="token.json"
# DRIVE_ROOT_FOLDER="Site Plaud"
#
# Seuil (Mo) : audio au-dessus -> MEGA (étape 4b), en-dessous -> backend d'archivage
# LARGE_FILE_THRESHOLD_MB=50
# MEGA_EMAIL=""
# MEGA_PASSWORD=""

# --- Étape 5 : email (Gmail SMTP) ---
# Prérequis : validation en 2 étapes activée sur le compte Google, puis créer un
# « mot de passe d'application » sur https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="ton.adresse@gmail.com"
# SMTP_PASSWORD="xxxxxxxxxxxxxxxx"   # les 16 caractères du mot de passe d'application
# MAIL_TO="destinataire@exemple.com"
# MAIL_FROM=""                       # vide -> identique à SMTP_USER

# --- Étape 7 : accès ---
# Mot de passe unique partagé pour limiter l'accès public (évite que n'importe qui
# remplisse ton Drive / brûle ton quota Groq). Vide = site ouvert.
# ACCESS_PASSWORD=""
